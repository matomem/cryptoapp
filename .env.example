# Copy this file to .env for local development. Never commit your real .env.
# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Random server-side configuration value, at least 32 characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Luno API credentials. Use a dedicated API key with minimum required permissions.
# Keep these server-side; never use VITE_ prefixes for secrets.
LUNO_API_KEY_ID=
LUNO_API_KEY_SECRET=
LUNO_API_BASE_URL=https://api.luno.com

# Restrict available crypto assets to those supported by your configured Luno account.
LUNO_ALLOWED_ASSETS=XBT

# Local server port
PORT=3000
NODE_ENV=development
